# ===========================================
# NexusAI - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# Google Gemini API Key (Free from https://aistudio.google.com)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# Tavily Web Search API Key (Free from https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Auth.js Secret (run: npx auth secret)
AUTH_SECRET=your_auth_secret_here

# GitHub OAuth (from GitHub Developer Settings > OAuth Apps)
AUTH_GITHUB_ID=your_github_client_id
AUTH_GITHUB_SECRET=your_github_client_secret

# Google OAuth (from Google Cloud Console > APIs & Credentials)
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# App URL
NEXTAUTH_URL=http://localhost:3000
