# ==============================================================================
# Enterprise AI Research Assistant — Environment Configuration
# ==============================================================================

# Application Metadata
PROJECT_NAME="Enterprise AI Research Assistant API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development" # Options: development, staging, production
LOG_LEVEL="INFO"          # Options: DEBUG, INFO, WARNING, ERROR

# Security & Secrets (Replace with a strong random secret in production)
SECRET_KEY="your-super-secret-hex-key-here-minimum-32-characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 days

# Database Configuration
# Local SQLite fallback:
DATABASE_URL="sqlite:///./nexusai_research.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/research_assistant"

# External Search & AI Model Providers
GOOGLE_API_KEY="your-gemini-api-key-here"
TAVILY_API_KEY=""
OPENAI_API_KEY=""

# Document Upload & Processing Limits
MAX_UPLOAD_SIZE_MB=25

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
