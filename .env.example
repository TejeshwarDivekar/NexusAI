# ==============================================================================
# AI Research Assistant — Root Environment Configuration
# ==============================================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local or any file containing real secrets.

# Backend Internal Routing (used by Next.js rewrites)
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Application Runtime
ENVIRONMENT=production
LOG_LEVEL=INFO

# NextAuth / Auth.js Configuration
AUTH_SECRET=                          # Generate with: npx auth secret
AUTH_TRUST_HOST=true                  # Required when behind reverse proxy
NEXTAUTH_URL=http://localhost:3000    # Set to your production URL in production

# Google OAuth (from Google Cloud Console > APIs & Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth (optional — from GitHub Developer Settings > OAuth Apps)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Backend JWT Security
SECRET_KEY=                           # Generate a random 32+ character string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080     # 7 days

# Database Configuration
# Local development (SQLite):
DATABASE_URL=sqlite:///./nexusai_research.db
# Production PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Google Gemini API Key (from https://aistudio.google.com)
GOOGLE_GENERATIVE_AI_API_KEY=

# Tavily Web Search API Key (optional — from https://tavily.com)
TAVILY_API_KEY=

# OpenAI API Key (optional fallback)
OPENAI_API_KEY=

# Document Upload Limits
MAX_UPLOAD_SIZE_MB=25

# CORS Allowed Origins (JSON array)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
